# Para onde os cadastros são enviados
EMAIL_DESTINO=pagamento@ferrasoldas.com.br

# Remetente. Com Resend, precisa ser de um domínio verificado no painel.
# Com SMTP, normalmente precisa ser a própria conta autenticada.
EMAIL_REMETENTE="Cadastro Ferrasoldas <cadastro@ferrasoldas.com.br>"

# "resend" ou "smtp"
EMAIL_PROVEDOR=smtp

# --- Se EMAIL_PROVEDOR=resend ---
RESEND_API_KEY=

# --- Se EMAIL_PROVEDOR=smtp ---
SMTP_HOST=
SMTP_PORTA=465
SMTP_SEGURO=true
SMTP_USUARIO=
SMTP_SENHA=
